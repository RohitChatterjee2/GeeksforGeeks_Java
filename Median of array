import java.util.*;

public class calc {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();

        int a1 [] = new int[m];
        int a2 [] = new int[n];

        for (int i = 0; i < m; i++) {
            a1[i] = sc.nextInt();
        }
        for (int j = 0; j < n; j++) {
            a2[j] = sc.nextInt();
        }

        int total = m + n;
        int[] merged = new int[total];

        int i = 0, j = 0, k = 0;
        while (i < m && j < n) {
            if (a1[i] <= a2[j]) {
                merged[k++] = a1[i++];
            } else {
                merged[k++] = a2[j++];
            }
        }
        while (i < m) {
            merged[k++] = a1[i++];
        }
        while (j < n) {
            merged[k++] = a2[j++];
        }

      
        double median;
        if (total % 2 == 1) {
            median = merged[total / 2];
        } else {
            median = (merged[(total / 2) - 1] + merged[total / 2]) / 2.0;
        }

        System.out.println(median);
    }
}
